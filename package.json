{
  "name": "pi-omniroute",
  "version": "0.4.0",
  "type": "module",
  "description": "OmniRoute provider extension for pi — one self-hosted gateway endpoint routing 350+ AI providers (Claude, GPT, Gemini, Kimi, GLM, DeepSeek, MiniMax, …) with free tiers, quota-aware auto-fallback, and token compression.",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "bun scripts/check.ts",
    "test": "bun tests/probe.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run check && bun run test && bun run typecheck",
    "prepublishOnly": "bun run verify"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "omniroute",
    "gateway",
    "proxy",
    "ai",
    "llm",
    "openai-compatible",
    "router",
    "pi-package"
  ],
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "@earendil-works/pi-ai": "0.84.4"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "models.ts",
    "models.json",
    "custom-models.json",
    "patch.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryan-brosas/pi-omniroute.git"
  },
  "homepage": "https://github.com/ryan-brosas/pi-omniroute",
  "bugs": {
    "url": "https://github.com/ryan-brosas/pi-omniroute/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
